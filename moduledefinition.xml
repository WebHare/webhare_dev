<module xmlns="http://www.webhare.net/xmlns/system/moduledefinition">

  <meta>
    <version>1.0.0</version>
    <description>webhare.dev site</description>
    <packaging download="true" webhareversion=">= 6.0.0" />
    <validation options="perfectcompile nomissingtids">
      <format masks="*.ts" />
    </validation>
  </meta>

  <servicemanager>
    <task script="scripts/tasks/import-repo.ts" tag="import_repo" description="Import the webhare_dev repository checkout" runatstartup="true" />
    <task runat="*/5 * * * *" script="scripts/tasks/update-from-github.ts" tag="update_from_github" description="Keep the webhare_dev main branch checkout up to date from GitHub" runatstartup="true" />
  </servicemanager>
</module>
